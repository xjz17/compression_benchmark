  "created_date": "2026-09-17",
  "purpose": "Versioned source-group plan for the weighted-GRPO time-series experiment. Test candidates require local schema, license, timestamp, and lineage audit before use.",
  "defaults": {
    "max_numeric_raw_bytes": 268435456,
    "block_max_bytes": 1048576,
    "split": "chronological_per_entity_80_20",
    "require_upstream_revision": true,
    "require_file_sha256": true,
    "timestamp_invalid_policy": "fail_no_row_index_fallback"
  },
  "domains": [
    {"id": "business", "label": "Business, retail, tourism, and real estate"},
    {"id": "computing", "label": "Computing systems, networks, and Web platforms"},
    {"id": "energy", "label": "Energy and industrial telemetry"},
    {"id": "environment", "label": "Weather, environment, agriculture, and ecology"},
    {"id": "finance", "label": "Markets, exchange rates, crypto, and macroeconomics"},
    {"id": "health", "label": "Health and human activity"},
    {"id": "science", "label": "Space and geophysical observation"},
    {"id": "traffic", "label": "Traffic and transportation"}
  ],
  "leakage_rules": [
    "No source_group may occur in both train_validation and test_candidate roles.",
    "Resampled frequencies, feature-engineered derivatives, missing-value variants, mirrors, and versioned releases of one upstream collection remain in one source_group.",
    "All files and entities from one upstream collection receive the same role; files are not promoted to independent datasets.",
    "Exact source hashes must be disjoint across roles. A test candidate with matching records, overlapping entity-time ranges, or uncertain upstream lineage is excluded until resolved.",
    "Dataset-level 80/20 splitting is performed independently inside each entity after deterministic continuous sampling; no block crosses that boundary.",
    "A test_candidate entry is not approved test evidence until its local audit_status is replaced in a run-specific manifest with source fingerprints and a passed schema audit."
  ],
  "same_source_exclusions": [
    {
      "source_group": "github:zhouhaoyi/ETDataset",
