      "reason": "Files and frequencies belong to the same ETT collection."
    },
    {
      "source_group": "hf:Dingdong-Inc/FreshRetailNet-50K",
      "members": ["freshretailnet_50k", "freshretailnet_lt"],
      "reason": "Size/version variants of the same retail source cannot cross roles."
    },
    {
      "source_group": "hf:byluuu/gluco-tsfm-benchmark",
      "members": ["gluco_tsfm_benchmark", "glucofm_bench"],
      "reason": "Patient series and benchmark variants must remain together."
    },
    {
      "source_group": "hf:reg-forecasting-upstream",
